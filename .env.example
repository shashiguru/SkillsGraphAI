# Copy to backend/.env (backend reads backend/.env, falling back to the repo root .env)
# Never put real keys in this file: it is committed to git.
PORT=3000
FRONTEND_URL=http://localhost:5173

# Neo4j Aura: use the neo4j+s:// URI shown when you create the instance
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Nosana inference (key starts with nos_)
NOSANA_API_KEY=
NOSANA_BASE_URL=https://inference.nosana.com/v1
# Optional. Leave empty to auto-select from GET /v1/models
NOSANA_MODEL=

# Daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Frontend only: put in frontend/.env if the API is not at http://localhost:3000/api
# VITE_API_BASE_URL=http://localhost:3000/api
